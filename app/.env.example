# Second Brain — Expo env. Copy to .env for local dev.
# All client-visible vars MUST be prefixed EXPO_PUBLIC_.

# FastAPI backend base URL (no trailing slash). Defaults to http://localhost:8000.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth. Leave BOTH unset to use "Continue in dev mode"
# (backend AUTH_DEV_MODE must be true to accept the literal token "dev").
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
