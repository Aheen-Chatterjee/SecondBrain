# Postgres (Supabase) SQLAlchemy URL. Defaults to local SQLite for dev if unset.
DATABASE_URL=sqlite+aiosqlite:///./secondbrain.db

# Verify Supabase JWTs (HS256). Required in prod.
SUPABASE_JWT_SECRET=

# When true, accepts the literal bearer token "dev" -> user 00000000-0000-0000-0000-000000000001
AUTH_DEV_MODE=true

# Enables real AI calls (via OpenRouter). When unset, endpoints fall back to
# deterministic behavior. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
# DeepSeek is text-only; snap-a-page OCR uses this vision-capable model instead.
OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Supabase storage uploads (book photos). Optional.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# YouTube playlist sync. Optional.
YOUTUBE_API_KEY=

# Comma-separated list, or "*" for all.
CORS_ORIGINS=*
