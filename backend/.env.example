# Postgres (Supabase) SQLAlchemy URL. Defaults to local SQLite for dev if unset.
DATABASE_URL=sqlite+aiosqlite:///./secondbrain.db

# Verify Supabase JWTs (HS256). Required in prod.
SUPABASE_JWT_SECRET=

# When true, accepts the literal bearer token "dev" -> user 00000000-0000-0000-0000-000000000001
AUTH_DEV_MODE=true

# Enables real AI calls. When unset, endpoints fall back to deterministic behavior.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase storage uploads (book photos). Optional.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# YouTube playlist sync. Optional.
YOUTUBE_API_KEY=

# Comma-separated list, or "*" for all.
CORS_ORIGINS=*
